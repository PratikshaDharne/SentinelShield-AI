# ---- SentinelShield AI unique deployment names ----
APP_NAME=SentinelShield AI
API_PORT=8130
DASHBOARD_PORT=8630
MYSQL_PORT=3337
MYSQL_DATABASE=sentinelshield_db
MYSQL_USER=sentinelshield_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
# SQLAlchemy URL used by the API (docker-compose overrides host to the mysql container)
DATABASE_URL=mysql+pymysql://sentinelshield_user:change_me_db_password@127.0.0.1:3337/sentinelshield_db

# ---- Owner (dashboard) login ----
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_owner_password
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRE_MINUTES=480

# ---- Answer LLMs: ONLY used to answer an already-approved prompt ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# ---- Guardrail ----
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_SIM_THRESHOLD=0.50   # run scripts/calibrate_threshold.py after switching encoders
REWRITE_MAX_TRIES=3
REWRITER_BACKEND=auto        # auto | t5 | template
LOG_RAW_PROMPTS=false        # keep false in production
LOG_RETENTION_DAYS=30
POLICY_VERSION=1.0.0

# ---- Offline evaluation ONLY (never used by the running API) ----
EVAL_JUDGE=ollama            # ollama | gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_JUDGE_MODEL=llama3.2:3b
OLLAMA_GUARD_MODEL=llama-guard3:1b
FORCE_Q_POLICY=false      # Q-policy is only used live if it beat the safe baseline on validation

# ---- Live deep-RL (online DQN). off | shadow (learns, baseline decides) | active (agent decides) | auto (shadow -> active only when it beats the baseline) ----
RL_MODE=shadow
RL_EXPLORE_EPS=0.0
